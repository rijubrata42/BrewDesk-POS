# GEMINI_API_KEY: Required if Gemini AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Cloud MongoDB connection string (e.g., MongoDB Atlas mongodb+srv://...).
# When set, all cafe POS collections persist directly to MongoDB.
# When omitted, the server persists atomically to data/pos-db.json with daily backups.
MONGODB_URI=""
MONGODB_DB_NAME="brewdesk_pos"

# JWT_SECRET: Secret key used to sign authentication tokens (set a strong random string in production).
JWT_SECRET="change-this-to-a-strong-random-secret"
